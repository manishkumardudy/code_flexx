class Solution {
public:
    string reverseWords(string s) {
        string word="";
        vector<string>words;
        for(auto x:s){
            if(x==' '&& word.size()!=0){
                reverse(word.begin(),word.end());
                words.push_back(word);
                word="";
            }
            else if(x!=' ') word+=x;
        }
        if(word.size()!=0){
                reverse(word.begin(),word.end());
                words.push_back(word);
    
            }
        string ans="";
        for(int i =0;i<words.size();i++){
            ans+=words[i];
            if(i!=words.size()-1)ans+=" ";
        }
        return ans;
        
    }
};
