class Solution {
public:
    bool detectCapitalUse(string word) {
        int i = 0;
        int upper = 0;

        while (i < word.size()) {
            if (isupper(word[i])) {
                upper++;
            }
            i++;
        }

        if (upper == word.size() || upper == 0) {
            return true;
        }

        if (upper == 1 && isupper(word[0])) {
            return true;
        }

        return false;
    }
};
